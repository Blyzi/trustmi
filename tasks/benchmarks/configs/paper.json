{
  "name": "paper",
  "description": "Cross-model evaluation suite for the final TrustMI steering vectors.",
  "auxiliary_model": {
    "model": "trustmi-aux/gpt-oss-120b",
    "reasoning_effort": "low",
    "max_tokens": 2048
  },
  "strengths": [-2.0, -1.0, 0.0, 1.0, 2.0],
  "eval_options": {
    "display": "plain",
    "fail_on_error": true,
    "max_samples": 32,
    "temperature": 0.8,
    "max_tokens": 4096,
    "message_limit": 20,
    "seed": 104729
  },
  "evals": [
    {
      "name": "agentharm_harmful",
      "task": "benchmarks.eval_tasks:agentharm_harmful",
      "description": "Harmful multi-step agent tasks: completion and refusal.",
      "task_args": {"split": "test_public"},
      "judge_args": ["refusal_judge", "semantic_judge"],
      "eval_options": {"epochs": 3},
      "metrics": [
        {"name": "avg_score", "label": "Harmful score", "direction": "lower"},
        {"name": "avg_full_score", "label": "Full harmful completion", "direction": "lower"},
        {"name": "avg_refusals", "label": "Refusal rate", "direction": "higher"}
      ],
      "tags": ["safety", "agentic"]
    },
    {
      "name": "agentharm_benign",
      "task": "benchmarks.eval_tasks:agentharm_benign",
      "description": "Benign counterparts of the AgentHarm tasks: completion and refusal.",
      "task_args": {"split": "test_public"},
      "judge_args": ["refusal_judge", "semantic_judge"],
      "eval_options": {"epochs": 3},
      "metrics": [
        {"name": "avg_score", "label": "Benign task score", "direction": "higher"},
        {"name": "avg_full_score", "label": "Full task completion", "direction": "higher"},
        {"name": "avg_refusals", "label": "Refusal rate", "direction": "lower"}
      ],
      "tags": ["capability", "agentic"]
    },
    {
      "name": "agentdojo_injected",
      "task": "benchmarks.eval_tasks:agentdojo",
      "description": "Prompt injections hidden in tool outputs: attack success and task utility.",
      "task_args": {"with_injections": true, "with_sandbox_tasks": "no"},
      "eval_options": {"epochs": 3},
      "metrics": [
        {"score": "security", "name": "accuracy", "label": "Attack success", "direction": "lower"},
        {"score": "utility", "name": "accuracy", "label": "Utility", "direction": "higher"}
      ],
      "tags": ["safety", "agentic"]
    },
    {
      "name": "agentdojo_benign",
      "task": "benchmarks.eval_tasks:agentdojo",
